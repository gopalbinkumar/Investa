<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_transaction_drawer"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/transaction_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Add Transaction"
            android:textColor="@color/investa_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/transaction_more"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/more_options"
            android:src="@drawable/ic_lucide_more_vertical"
            android:tint="@color/investa_icon_primary"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="Date"
        android:textColor="@color/investa_text_secondary"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/transaction_date"
        style="@style/FormInput"
        android:clickable="true"
        android:drawableEnd="@drawable/ic_lucide_calendar"
        android:drawablePadding="8dp"
        android:focusable="false"
        android:hint="29 August 2026"
        android:inputType="none" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quantity"
        android:textColor="@color/investa_text_secondary"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <EditText
            android:id="@+id/transaction_quantity"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="center_vertical|start"
            android:hint="0.005"
            android:inputType="numberDecimal"
            android:padding="0dp"
            android:singleLine="true"
            android:textColor="@color/investa_text"
            android:textColorHint="@color/investa_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/transaction_quantity_unit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:textColor="@color/investa_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/transaction_price_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Price"
        android:textColor="@color/investa_text_secondary"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <EditText
            android:id="@+id/transaction_price"
            style="@style/FormInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="center_vertical|start"
            android:hint="1.200.000.000"
            android:inputType="numberDecimal"
            android:padding="0dp" />

        <TextView
            android:id="@+id/transaction_price_unit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:textColor="@color/investa_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fee (Optional)"
            android:textColor="@color/investa_text_secondary"
            android:textSize="11sp" />

        <CheckBox
            android:id="@+id/transaction_fee_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/investa_primary"
            android:checked="true" />
    </LinearLayout>

    <EditText
        android:id="@+id/transaction_fee"
        style="@style/FormInput"
        android:hint="Rp 25.000"
        android:inputType="numberDecimal" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notes"
        android:textColor="@color/investa_text_secondary"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/transaction_notes"
        style="@style/FormInput"
        android:gravity="center_vertical|start"
        android:hint="Ex: DCA weekly"
        android:inputType="textMultiLine"
        android:minLines="3" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total"
        android:textColor="@color/investa_text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/transaction_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:text="Rp 6.025.000"
        android:textColor="@color/investa_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/transaction_save"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_primary_button"
        android:gravity="center"
        android:text="Save Transaction"
        android:textColor="@color/investa_background"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
