<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/investa_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="Reports"
            android:textColor="@color/investa_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Portfolio Performance"
            android:textColor="@color/investa_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Invested"
                        android:textColor="@color/investa_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/reports_invested_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 106.900.000"
                        android:textColor="@color/investa_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/reports_back"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="@string/back"
                    android:src="@drawable/ic_lucide_arrow_right"
                    android:tint="@color/investa_icon_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Value"
                        android:textColor="@color/investa_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/reports_current_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp 125.650.000"
                        android:textColor="@color/investa_mint"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <com.example.investa.PerformanceChartView
                android:id="@+id/performance_chart"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="20dp" />

            <LinearLayout
                android:id="@+id/performance_month_labels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/reports_profit_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+Rp 18.750.000"
                    android:textColor="@color/investa_mint"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/reports_profit_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="+17.56%"
                    android:textColor="@color/investa_mint" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Summary"
            android:textColor="@color/investa_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/report_toggle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_surface"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/toggle_category"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_button"
                android:gravity="center"
                android:text="By Category"
                android:textColor="@color/investa_background"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/toggle_asset"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="By Asset"
                android:textColor="@color/investa_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/category_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_surface"
            android:orientation="vertical"
            android:padding="16dp" />
    </LinearLayout>
</ScrollView>
