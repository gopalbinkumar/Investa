<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_transaction_drawer"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <TextView
        android:id="@+id/cash_drawer_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/add_cash"
        android:textColor="@color/investa_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/currency"
        android:textColor="@color/investa_text_secondary"
        android:textSize="11sp" />

    <Spinner
        android:id="@+id/cash_currency"
        style="@style/FormSpinner"
        android:spinnerMode="dropdown" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/amount"
        android:textColor="@color/investa_text_secondary"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/cash_amount"
        style="@style/FormInput"
        android:foreground="@drawable/ripple_surface"
        android:hint="@string/hint_cash_amount"
        android:inputType="numberDecimal" />

    <TextView
        android:id="@+id/cash_save"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_primary_button"
        android:foreground="@drawable/ripple_button"
        android:gravity="center"
        android:text="@string/save_cash"
        android:textColor="@color/investa_background"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
