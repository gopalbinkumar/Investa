<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/investa_background" />
            <stroke
                android:width="1dp"
                android:color="@color/investa_border" />
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
        </shape>
    </item>
    <item
        android:gravity="bottom"
        android:height="1dp">
        <shape>
            <solid android:color="@color/investa_background" />
        </shape>
    </item>
</layer-list>
