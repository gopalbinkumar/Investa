<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/investa_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="18dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="@string/reports"
        android:textColor="@color/investa_text"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/reports_scroll"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/realized_gain_loss"
        android:textColor="@color/investa_text"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_surface"
            android:orientation="vertical"
            android:tag="investa_elevated_card"
            android:padding="16dp">

            <TextView
                android:id="@+id/reports_realized_pl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zero_amount"
        android:textColor="@color/investa_highlight"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/portfolio_performance"
        android:textColor="@color/investa_text"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_surface"
            android:orientation="vertical"
            android:tag="investa_elevated_card"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_invested"
        android:textColor="@color/investa_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/reports_invested_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dummy_invested_amount"
        android:textColor="@color/investa_text"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/reports_back"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="@string/back"
                    android:src="@drawable/ic_lucide_arrow_right"
        android:tint="@color/investa_icon_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/current_value"
        android:textColor="@color/investa_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/reports_current_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dummy_current_value"
        android:textColor="@color/investa_highlight"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />
                </LinearLayout>
            </LinearLayout>

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/performance_chart"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="20dp" />

            <LinearLayout
                android:id="@+id/performance_month_labels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/reports_profit_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dummy_profit_amount"
        android:textColor="@color/investa_highlight"
                    android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />

                <TextView
                    android:id="@+id/reports_profit_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/dummy_profit_percent"
        android:textColor="@color/investa_highlight" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/summary"
        android:textColor="@color/investa_text"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />

        <LinearLayout
            android:id="@+id/report_toggle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_surface"
            android:orientation="horizontal"
            android:tag="investa_elevated_card">

            <TextView
                android:id="@+id/toggle_category"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_button"
                android:foreground="@drawable/ripple_button"
                android:stateListAnimator="@animator/press_scale_button"
                android:gravity="center"
                android:text="@string/by_category"
        android:textColor="@color/investa_background"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/toggle_asset"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:foreground="@drawable/ripple_button"
                android:stateListAnimator="@animator/press_scale_button"
                android:gravity="center"
                android:text="@string/by_asset"
        android:textColor="@color/investa_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/category_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_surface"
            android:orientation="vertical"
            android:tag="investa_elevated_card"
            android:padding="16dp" />
    </LinearLayout>
    </ScrollView>
</LinearLayout>
