<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/investa_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="18dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="@string/cash"
            android:textColor="@color/investa_text"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />
    </LinearLayout>

    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="24dp">

<!--        <TextView-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_marginTop="6dp"-->
<!--            android:text="@string/manage_available_cash"-->
<!--            android:textColor="@color/investa_text_secondary"-->
<!--            android:textSize="13sp" />-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_cash_total"
            android:orientation="vertical"
            android:tag="investa_elevated_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_cash"
                android:textColor="@color/investa_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/cash_total_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/zero_amount"
                android:textColor="@color/investa_text"
                android:textSize="24sp"
                android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />

            <TextView
                android:id="@+id/cash_total_usd_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/investa_text_secondary"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/cash_accounts"
            android:textColor="@color/investa_text"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />

        <LinearLayout
            android:id="@+id/cash_accounts_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/cash_add"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_primary_button"
            android:foreground="@drawable/ripple_button"
            android:stateListAnimator="@animator/press_scale_button"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/add_cash"
                android:src="@drawable/ic_lucide_plus"
                android:tint="@color/investa_background" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/add_cash"
                android:textColor="@color/investa_background"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
