<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/investa_background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingStart="12dp"
        android:paddingTop="18dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/form_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/back"
            android:foreground="@drawable/ripple_icon"
            android:src="@drawable/ic_lucide_arrow_left"
            android:tint="@color/investa_icon_primary" />

        <TextView
            android:id="@+id/form_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/investa_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="25dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/asset_name"
                android:textColor="@color/investa_text_secondary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/form_name"
                style="@style/FormInput"
                android:foreground="@drawable/ripple_surface"
                android:hint="@string/hint_asset_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/symbol"
                android:textColor="@color/investa_text_secondary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/form_symbol"
                style="@style/FormInput"
                android:foreground="@drawable/ripple_surface"
                android:hint="@string/hint_symbol"
                android:inputType="textCapCharacters" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category"
                android:textColor="@color/investa_text_secondary"
                android:textSize="11sp" />

            <Spinner
                android:id="@+id/form_category"
                style="@style/FormSpinner" />

            <LinearLayout
                android:id="@+id/asset_fields_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quantity"
                    android:textColor="@color/investa_text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_input"
                    android:foreground="@drawable/ripple_surface"
                    android:gravity="center_vertical"
                    android:addStatesFromChildren="true"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <EditText
                        android:id="@+id/form_quantity"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical|start"
                        android:hint="@string/hint_quantity"
                        android:inputType="numberDecimal"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/investa_text"
                        android:textColorHint="@color/investa_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/form_quantity_unit_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical|end"
                        android:textColor="@color/investa_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/average_price"
                    android:textColor="@color/investa_text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_input"
                    android:foreground="@drawable/ripple_surface"
                    android:gravity="center_vertical"
                    android:addStatesFromChildren="true"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <EditText
                        android:id="@+id/form_average_price"
                        style="@style/FormInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical|start"
                        android:hint="@string/hint_average_price"
                        android:inputType="numberDecimal"
                        android:padding="0dp" />

                    <TextView
                        android:id="@+id/form_average_price_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical|end"
                        android:textColor="@color/investa_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/invested_amount"
                    android:textColor="@color/investa_text_secondary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/form_invested"
                    style="@style/FormReadonlyInput"
                    android:hint="@string/hint_invested_amount"
                    android:inputType="numberDecimal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/current_price"
                    android:textColor="@color/investa_text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_input"
                    android:foreground="@drawable/ripple_surface"
                    android:gravity="center_vertical"
                    android:addStatesFromChildren="true"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <EditText
                        android:id="@+id/form_current_price"
                        style="@style/FormInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical|start"
                        android:hint="@string/hint_current_price"
                        android:inputType="numberDecimal"
                        android:padding="0dp" />

                    <TextView
                        android:id="@+id/form_current_price_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical|end"
                        android:textColor="@color/investa_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/currency"
                    android:textColor="@color/investa_text_secondary"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/form_currency"
                    style="@style/FormSpinner" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notes_optional"
                    android:textColor="@color/investa_text_secondary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/form_notes"
                    style="@style/FormInput"
                    android:foreground="@drawable/ripple_surface"
                    android:gravity="center_vertical|start"
                    android:hint="@string/hint_notes"
                    android:inputType="textMultiLine"
                    android:minLines="3" />

                <TextView
                    android:id="@+id/form_save"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_primary_button"
                    android:foreground="@drawable/ripple_button"
                    android:gravity="center"
                    android:textColor="@color/investa_background"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
