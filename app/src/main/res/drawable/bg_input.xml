<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/investa_surface" />
            <stroke android:width="2dp" android:color="@color/investa_primary" />
            <corners android:radius="17dp" />
            <padding android:left="14dp" android:top="2dp" android:right="14dp" android:bottom="2dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/investa_surface" />
            <stroke android:width="1dp" android:color="@color/investa_border" />
            <corners android:radius="17dp" />
            <padding android:left="14dp" android:top="2dp" android:right="14dp" android:bottom="2dp" />
        </shape>
    </item>
</selector>
