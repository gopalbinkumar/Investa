<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/investa_background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingStart="12dp"
        android:paddingTop="18dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/export_backup_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/back"
            android:foreground="@drawable/ripple_icon"
            android:src="@drawable/ic_lucide_arrow_left"
            android:tint="@color/investa_icon_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/export_backup"
            android:textColor="@color/investa_text"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
            android:tag="investa_semibold_text" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="18dp"
            android:paddingEnd="12dp"
            android:paddingBottom="25dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/export_backup_description"
                android:textColor="@color/investa_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/backup_includes"
                android:textColor="@color/investa_text"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_semibold"
                android:tag="investa_semibold_text" />

            <LinearLayout
                android:id="@+id/export_backup_contents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_surface"
                android:orientation="vertical"
                android:padding="16dp"
                android:tag="investa_elevated_card">

                <include layout="@layout/view_detail_row" />
                <include layout="@layout/view_detail_row" />
                <include layout="@layout/view_detail_row" />
                <include layout="@layout/view_detail_row" />
                <include layout="@layout/view_detail_row" />
            </LinearLayout>

            <TextView
                android:id="@+id/export_backup_create"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_primary_button"
                android:foreground="@drawable/ripple_button"
                android:stateListAnimator="@animator/press_scale_button"
                android:gravity="center"
                android:text="@string/create_backup_file"
                android:textColor="@color/investa_on_primary"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_semibold"
                android:tag="investa_semibold_text" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
