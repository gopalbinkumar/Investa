<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/investa_background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingStart="12dp"
        android:paddingTop="18dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/exchange_rate_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/back"
            android:foreground="@drawable/ripple_icon"
            android:src="@drawable/ic_lucide_arrow_left"
            android:tint="@color/investa_icon_primary" />

        <TextView
            android:id="@+id/exchange_rate_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/change_exchange_rate"
            android:textColor="@color/investa_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/exchange_rate_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/refresh_exchange_rate"
            android:foreground="@drawable/ripple_icon">

            <ImageView
                android:id="@+id/exchange_rate_refresh_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_lucide_rotate_cw"
                android:tint="@color/investa_icon_primary" />

            <ProgressBar
                android:id="@+id/exchange_rate_refresh_progress"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/investa_primary"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/currency"
                android:textColor="@color/investa_text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input_readonly"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/currency_usd"
                    android:textColor="@color/investa_text"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/us_dollar"
                    android:textColor="@color/investa_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exchange_rate"
                android:textColor="@color/investa_text_secondary"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/exchange_rate_input"
                style="@style/FormInput"
                android:foreground="@drawable/ripple_surface"
                android:hint="@string/hint_exchange_rate"
                android:inputType="numberDecimal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:text="@string/exchange_rate_description"
                android:textColor="@color/investa_icon_inactive"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/exchange_rate_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_primary_button"
                android:foreground="@drawable/ripple_button"
                android:gravity="center"
                android:text="@string/save_changes"
                android:textColor="@color/investa_background"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
