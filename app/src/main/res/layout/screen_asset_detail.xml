<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/investa_background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="18dp"
        android:paddingEnd="12dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="42dp">

            <ImageView
                android:id="@+id/detail_back"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="start|center_vertical"
                android:contentDescription="@string/back"
                android:foreground="@drawable/ripple_icon"
                android:src="@drawable/ic_lucide_arrow_left"
                android:tint="@color/investa_icon_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/asset_detail"
                android:textColor="@color/investa_text"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />

            <ImageView
                android:id="@+id/detail_more"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:contentDescription="@string/more_options"
                android:foreground="@drawable/ripple_icon"
                android:src="@drawable/ic_lucide_more_vertical"
                android:tint="@color/investa_icon_primary" />
        </FrameLayout>
    </FrameLayout>

    <ScrollView
        android:id="@+id/detail_scroll"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="25dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/detail_symbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/investa_text"
                android:textSize="22sp"
                android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />

            <TextView
                android:id="@+id/detail_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/investa_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/detail_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/investa_text"
            android:textSize="25sp"
            android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />

        <TextView
            android:id="@+id/detail_profit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/investa_highlight"
            android:textSize="15sp"
            android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />

        <LinearLayout
            android:id="@+id/detail_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_surface"
            android:orientation="vertical"
            android:tag="investa_elevated_card"
            android:padding="16dp">

            <include layout="@layout/view_detail_row" />

            <include layout="@layout/view_detail_row" />

            <include layout="@layout/view_detail_row" />

            <include layout="@layout/view_detail_row" />

            <include layout="@layout/view_detail_row" />

            <include layout="@layout/view_detail_row" />
        </LinearLayout>

        <TextView
            android:id="@+id/detail_change_current_price"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_outline_button"
            android:foreground="@drawable/ripple_button"
            android:stateListAnimator="@animator/press_scale_button"
            android:gravity="center"
            android:text="@string/change_current_price"
            android:textColor="@color/investa_primary"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/detail_buy"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_profit_button"
                android:clickable="true"
                android:foreground="@drawable/ripple_profit"
                android:stateListAnimator="@animator/press_scale_button"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/buy"
                    android:textColor="@color/investa_background"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text"/>
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:id="@+id/detail_sell"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_sell_button"
                android:clickable="true"
                android:foreground="@drawable/ripple_loss"
                android:stateListAnimator="@animator/press_scale_button"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sell"
                    android:textColor="@color/investa_background"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/history"
            android:textColor="@color/investa_text"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
            android:tag="investa_semibold_text" />

        <LinearLayout
            android:id="@+id/detail_history_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />
    </LinearLayout>
    </ScrollView>
</LinearLayout>
