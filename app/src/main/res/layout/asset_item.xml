<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/asset_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_surface"
    android:foreground="@drawable/ripple_surface"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/asset_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/investa_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/asset_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/investa_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/asset_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/investa_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/asset_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/investa_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/asset_summary_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/asset_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/investa_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/asset_profit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/investa_mint"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/asset_chevron"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_lucide_chevron_right"
        android:tint="@color/investa_icon_secondary" />
</LinearLayout>
