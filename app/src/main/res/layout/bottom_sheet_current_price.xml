<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_transaction_drawer"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="32dp">

        <TextView
            android:id="@+id/current_price_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/change_current_price"
            android:textColor="@color/investa_text"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />

        <FrameLayout
            android:id="@+id/current_price_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/refresh_current_price"
            android:foreground="@drawable/ripple_icon">

            <ImageView
                android:id="@+id/current_price_refresh_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lucide_rotate_cw"
                android:tint="@color/investa_icon_secondary" />

            <ProgressBar
                android:id="@+id/current_price_refresh_progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/investa_primary"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <com.example.investa.ui.common.VerticalShadowScrollView
        android:id="@+id/current_price_content_scroll"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingTop="11dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
            android:text="@string/current_price"
        android:textColor="@color/investa_text_secondary"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_input"
        android:foreground="@drawable/ripple_surface"
        android:tag="investa_input_field"
        android:gravity="center_vertical"
        android:addStatesFromChildren="true"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <EditText
            android:id="@+id/current_price_input"
            style="@style/FormInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:tag="@null"
            android:gravity="center_vertical|start"
            android:hint="@string/hint_price"
            android:inputType="numberDecimal"
            android:padding="0dp" />

        <TextView
            android:id="@+id/current_price_unit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:textColor="@color/investa_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/current_price_save"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_primary_button"
        android:foreground="@drawable/ripple_button"
        android:stateListAnimator="@animator/press_scale_button"
        android:gravity="center"
        android:text="@string/save"
        android:textColor="@color/investa_background"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />

    </LinearLayout>
    </com.example.investa.ui.common.VerticalShadowScrollView>
</LinearLayout>
