<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp"
    android:background="@drawable/bg_portfolio_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/total_portfolio_value"
        android:textColor="@color/investa_mint"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/portfolio_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/dummy_portfolio_value"
        android:textColor="@color/investa_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/portfolio_profit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dummy_profit_amount"
            android:textColor="@color/investa_mint"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/portfolio_profit_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/dummy_profit_percent"
            android:textColor="@color/investa_mint"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
