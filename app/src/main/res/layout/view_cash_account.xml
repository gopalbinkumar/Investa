<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_surface"
    android:tag="investa_elevated_card"
    android:foreground="@drawable/ripple_surface"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:padding="14dp"
    android:stateListAnimator="@animator/press_scale_asset">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cash_account_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
        android:textColor="@color/investa_text"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />

        <TextView
            android:id="@+id/cash_account_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
        android:textColor="@color/investa_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cash_account_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
        android:textColor="@color/investa_text"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_semibold"
        android:tag="investa_semibold_text" />

        <TextView
            android:id="@+id/cash_account_idr_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
        android:textColor="@color/investa_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
