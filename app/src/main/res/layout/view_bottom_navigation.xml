<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:background="@drawable/bg_bottom_navigation">

    <LinearLayout android:id="@+id/nav_home" style="@style/BottomNavItem">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_lucide_house" android:tint="@color/nav_icon_tint" android:duplicateParentState="true" android:contentDescription="@string/home" />
    </LinearLayout>
    <LinearLayout android:id="@+id/nav_assets" style="@style/BottomNavItem">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_lucide_wallet_cards" android:tint="@color/nav_icon_tint" android:duplicateParentState="true" android:contentDescription="@string/assets" />
    </LinearLayout>
    <LinearLayout android:id="@+id/nav_reports" style="@style/BottomNavItem">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_lucide_chart_pie" android:tint="@color/nav_icon_tint" android:duplicateParentState="true" android:contentDescription="@string/reports" />
    </LinearLayout>
    <LinearLayout android:id="@+id/nav_settings" style="@style/BottomNavItem">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_lucide_settings" android:tint="@color/nav_icon_tint" android:duplicateParentState="true" android:contentDescription="@string/settings" />
    </LinearLayout>
</LinearLayout>
